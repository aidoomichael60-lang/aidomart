# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where AIDOMART is hosted (used for email verification & password reset links).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Strong random secret used to sign session cookies and CSRF tokens.
SESSION_SECRET="replace-with-a-long-random-secret-string"

# BREVO_API_KEY: Transactional email API key from Brevo (stored server-side only, never exposed to client).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="aidoomichael60@gmail.com"
BREVO_SENDER_NAME="AIDOMART"

# Google Sign-In (Gmail / Google Account OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Analytics 4 (Optional — can also be configured inside Admin Dashboard)
VITE_GA_MEASUREMENT_ID=""

